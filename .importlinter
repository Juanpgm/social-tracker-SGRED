[importlinter]
root_package = social_tracker
include_external_packages = True

# Static analysis only: dynamic imports (__import__, importlib.import_module) and builtins
# such as open() are invisible to import-linter. Importing importlib itself is forbidden.
[importlinter:contract:domain-purity]
name = Domain modules must not depend on adapters, persistence, entrypoints or I/O libraries
type = forbidden
source_modules =
    social_tracker.domain
    social_tracker.**.domain
forbidden_modules =
    social_tracker.adapters
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.**.adapters
    social_tracker.**.persistence
    social_tracker.**.entrypoints
    social_tracker.infrastructure
    social_tracker.storage
    social_tracker.**.infrastructure
    social_tracker.**.storage
    sqlite3
    yaml
    typer
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    os
    pathlib
    io
    shutil
    socket
    ssl
    subprocess
    urllib
    http
    asyncio
    importlib
    tempfile
    glob

# Services (application layer) depend on ports only. They receive repositories, the clock and a
# UnitOfWork by constructor injection and must never import the storage adapters, SQLite or the
# entrypoints. `yaml` stays allowed for the codec, which is I/O-format code and not a domain module.
[importlinter:contract:services-use-ports-only]
name = Services must not depend on persistence, SQLite or entrypoints
type = forbidden
source_modules =
    social_tracker.*.service
    social_tracker.*.yaml_io
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    sqlite3
    typer

# Entrypoints (the CLI today, an API later) never touch storage themselves: they get ready-made
# services from the composition root, `social_tracker.bootstrap`, where the adapters are wired.
# `allow_indirect_imports` lets an entrypoint import the composition root even though that module
# imports persistence; only a DIRECT import of persistence or sqlite3 from an entrypoint is a
# violation.
[importlinter:contract:entrypoints-via-composition-root]
name = Entrypoints must reach storage only through the composition root
type = forbidden
source_modules =
    social_tracker.entrypoints
forbidden_modules =
    social_tracker.persistence
    sqlite3
allow_indirect_imports = True

# The web UI only ever answers requests: it must not open connections of its own (G-1) and must not
# import the collector, the worker side that does (it reaches the composition root only). Only the
# modules of this package are checked, so the server (uvicorn) may still listen. `urllib` cannot be
# listed (import-linter only names top-level external packages and the UI needs `urllib.parse`);
# tests/entrypoints/web/test_no_outbound.py forbids `urllib.request` for the web package.
[importlinter:contract:web-no-outbound-network]
name = The web UI must not make outbound network calls
type = forbidden
source_modules =
    social_tracker.entrypoints.web
forbidden_modules =
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    http
    socket
    websockets
    smtplib
    ftplib
    social_tracker.collector
allow_indirect_imports = True

# The one outbound path (G-1): the collector's fetcher adapter is the only module of the
# application allowed to import an HTTP client or sockets, and it may use only httpx2, httpcore2
# (the connection layer under httpx2) and socket.
# Everything else, the composition root included, reaches the network through the Fetcher port.
# Indirect imports are allowed so that the composition root can wire the adapter.
[importlinter:contract:outbound-only-in-fetcher]
name = Only the fetcher adapter may open network connections
type = forbidden
source_modules =
    social_tracker
forbidden_modules =
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    socket
    websockets
    smtplib
    ftplib
allow_indirect_imports = True
ignore_imports =
    social_tracker.collector.http_fetcher -> httpx2
    social_tracker.collector.http_fetcher -> httpcore2
    social_tracker.collector.http_fetcher -> socket
    social_tracker.llm.ollama -> httpx2
unmatched_ignore_imports_alerting = none

# The collector's logic (parsing, normalizing, address policy, the service and the worker loop)
# does no I/O of its own: no storage, no sockets, no processes. It gets a Fetcher and the
# repositories through constructor injection.
[importlinter:contract:collector-core-no-io]
name = The collector core must not do I/O
type = forbidden
source_modules =
    social_tracker.collector.feed
    social_tracker.collector.normalize
    social_tracker.collector.netpolicy
    social_tracker.collector.service
    social_tracker.collector.worker
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    sqlite3
    socket
    ssl
    subprocess
    httpx
    httpx2
    httpcore2
    requests
    aiohttp

# The classification core (RC-10: the CPU stages are deterministic). EVERY module of
# `social_tracker.classification` is core unless it is on the allowlist below, so a module added
# later is checked from its first line without anyone remembering to list it. The core is pure:
# no storage, no format libraries, no files, logging, threads or sockets, and no source of
# non-determinism (randomness, the wall clock). It knows nothing of the other modules.
#
# The allowlist (the exceptions, all imports ignored) is the application layer and its seams:
#   service  the use cases: they log, and they hold the clock and the repositories by injection
#   ports    the interfaces the service needs
#   yaml_io  the YAML codec of the vocabulary
# `datetime.now()` and friends cannot be banned by an import rule (the core needs the `datetime`
# types); tests/architecture/test_classification_clock.py reads the source for those calls instead.
[importlinter:contract:classification-core-pure]
name = The classification core must be pure and deterministic
type = forbidden
source_modules =
    social_tracker.classification.*
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.control
    social_tracker.items
    social_tracker.sources
    social_tracker.collector
    social_tracker.bootstrap
    social_tracker.classification.service
    social_tracker.classification.ports
    social_tracker.classification.yaml_io
    sqlite3
    yaml
    typer
    httpx
    httpx2
    requests
    aiohttp
    os
    pathlib
    io
    shutil
    socket
    ssl
    subprocess
    urllib
    http
    asyncio
    importlib
    tempfile
    glob
    random
    time
    secrets
    uuid
    logging
    threading
ignore_imports =
    social_tracker.classification.service -> **
    social_tracker.classification.ports -> **
    social_tracker.classification.yaml_io -> **
unmatched_ignore_imports_alerting = none

# The catalog module (the official-catalog cache, RC-6): parsing, request building, the refresher,
# the cached check and the status read ports only. It never opens a connection or a file itself:
# the refresher gets the collector's Fetcher port by injection (the SSRF-safe fetcher is the only
# outbound path) and the cache is reached through `CatalogRepository`.
[importlinter:contract:catalog-no-io]
name = The catalog module must do no I/O of its own
type = forbidden
source_modules =
    social_tracker.catalog.*
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.bootstrap
    social_tracker.collector.http_fetcher
    sqlite3
    socket
    ssl
    subprocess
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    os
    pathlib
    typer
