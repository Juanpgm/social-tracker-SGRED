[importlinter]
root_package = social_tracker
include_external_packages = True

# Static analysis only: dynamic imports (__import__, importlib.import_module) and builtins
# such as open() are invisible to import-linter. Importing importlib itself is forbidden.
[importlinter:contract:domain-purity]
name = Domain modules must not depend on adapters, persistence, entrypoints or I/O libraries
type = forbidden
source_modules =
    social_tracker.domain
    social_tracker.**.domain
forbidden_modules =
    social_tracker.adapters
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.**.adapters
    social_tracker.**.persistence
    social_tracker.**.entrypoints
    social_tracker.infrastructure
    social_tracker.storage
    social_tracker.**.infrastructure
    social_tracker.**.storage
    sqlite3
    yaml
    typer
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    os
    pathlib
    io
    shutil
    socket
    ssl
    subprocess
    urllib
    http
    asyncio
    importlib
    tempfile
    glob

# Services (application layer) depend on ports only. They receive repositories, the clock and a
# UnitOfWork by constructor injection and must never import the storage adapters, SQLite or the
# entrypoints. `yaml` stays allowed for the codec, which is I/O-format code and not a domain module.
[importlinter:contract:services-use-ports-only]
name = Services must not depend on persistence, SQLite or entrypoints
type = forbidden
source_modules =
    social_tracker.*.service
    social_tracker.*.yaml_io
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    sqlite3
    typer

# Entrypoints (the CLI today, an API later) never touch storage themselves: they get ready-made
# services from the composition root, `social_tracker.bootstrap`, where the adapters are wired.
# `allow_indirect_imports` lets an entrypoint import the composition root even though that module
# imports persistence; only a DIRECT import of persistence or sqlite3 from an entrypoint is a
# violation.
[importlinter:contract:entrypoints-via-composition-root]
name = Entrypoints must reach storage only through the composition root
type = forbidden
source_modules =
    social_tracker.entrypoints
forbidden_modules =
    social_tracker.persistence
    sqlite3
allow_indirect_imports = True

# The web UI only ever answers requests: it must not open connections of its own (G-1) and must not
# import the collector, the worker side that does (it reaches the composition root only). Only the
# modules of this package are checked, so the server (uvicorn) may still listen. `urllib` cannot be
# listed (import-linter only names top-level external packages and the UI needs `urllib.parse`);
# tests/entrypoints/web/test_no_outbound.py forbids `urllib.request` for the web package.
[importlinter:contract:web-no-outbound-network]
name = The web UI must not make outbound network calls
type = forbidden
source_modules =
    social_tracker.entrypoints.web
forbidden_modules =
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    http
    socket
    websockets
    smtplib
    ftplib
    social_tracker.collector
    social_tracker.llm.ollama
allow_indirect_imports = True

# The outbound paths (G-1): the collector's fetcher adapter is the only module that reaches the
# internet, and it may use only httpx2, httpcore2 (the connection layer under httpx2) and socket.
# The one other client is the Ollama adapter of the LLM escalation, which talks to this machine
# only (see `llm-adapter-loopback-only`) and may import httpx2 and nothing else of this list.
# Both clients enforce their wall-clock deadline inside the I/O through `shared.iodeadline`, the
# one module besides them that names httpx2 and httpcore2 (it opens no connection of its own).
# Everything else, the composition root included, reaches the network through the Fetcher and
# LlmJudge ports.
# Indirect imports are allowed so that the composition root can wire the adapter.
[importlinter:contract:outbound-only-in-fetcher]
name = Only the fetcher adapter may open network connections
type = forbidden
source_modules =
    social_tracker
forbidden_modules =
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    socket
    websockets
    smtplib
    ftplib
allow_indirect_imports = True
ignore_imports =
    social_tracker.collector.http_fetcher -> httpx2
    social_tracker.collector.http_fetcher -> httpcore2
    social_tracker.collector.http_fetcher -> socket
    social_tracker.shared.iodeadline -> httpx2
    social_tracker.shared.iodeadline -> httpcore2
    social_tracker.llm.ollama -> httpx2
unmatched_ignore_imports_alerting = none

# The collector's logic (parsing, normalizing, address policy, the service and the worker loop)
# does no I/O of its own: no storage, no sockets, no processes. It gets a Fetcher and the
# repositories through constructor injection.
[importlinter:contract:collector-core-no-io]
name = The collector core must not do I/O
type = forbidden
source_modules =
    social_tracker.collector.feed
    social_tracker.collector.normalize
    social_tracker.collector.netpolicy
    social_tracker.collector.service
    social_tracker.collector.worker
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    sqlite3
    socket
    ssl
    subprocess
    httpx
    httpx2
    httpcore2
    requests
    aiohttp

# The classification core (RC-10: the CPU stages are deterministic). EVERY module of
# `social_tracker.classification` is core unless it is on the allowlist below, so a module added
# later is checked from its first line without anyone remembering to list it. The core is pure:
# no storage, no format libraries, no files, logging, threads or sockets, and no source of
# non-determinism (randomness, the wall clock). It knows nothing of the other modules.
#
# The allowlist (the exceptions, all imports ignored) is the application layer and its seams:
#   service  the use cases: they log, and they hold the clock and the repositories by injection
#   ports    the interfaces the service needs
#   yaml_io  the YAML codec of the vocabulary
# `datetime.now()` and friends cannot be banned by an import rule (the core needs the `datetime`
# types); tests/architecture/test_classification_clock.py reads the source for those calls instead.
[importlinter:contract:classification-core-pure]
name = The classification core must be pure and deterministic
type = forbidden
source_modules =
    social_tracker.classification.*
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.control
    social_tracker.items
    social_tracker.sources
    social_tracker.collector
    social_tracker.bootstrap
    social_tracker.classification.service
    social_tracker.classification.ports
    social_tracker.classification.yaml_io
    sqlite3
    yaml
    typer
    httpx
    httpx2
    requests
    aiohttp
    os
    pathlib
    io
    shutil
    socket
    ssl
    subprocess
    urllib
    http
    asyncio
    importlib
    tempfile
    glob
    random
    time
    secrets
    uuid
    logging
    threading
ignore_imports =
    social_tracker.classification.service -> **
    social_tracker.classification.ports -> **
    social_tracker.classification.yaml_io -> **
unmatched_ignore_imports_alerting = none

# The catalog module (the official-catalog cache, RC-6): parsing, request building, the refresher,
# the cached check and the status read ports only. It never opens a connection or a file itself:
# the refresher gets the collector's Fetcher port by injection (the SSRF-safe fetcher is the only
# outbound path) and the cache is reached through `CatalogRepository`.
[importlinter:contract:catalog-no-io]
name = The catalog module must do no I/O of its own
type = forbidden
source_modules =
    social_tracker.catalog.*
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.bootstrap
    social_tracker.collector.http_fetcher
    sqlite3
    socket
    ssl
    subprocess
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    os
    pathlib
    typer

# The LLM escalation (RC-7, RC-9, RC-12). Its logic (vocabulary, strict output schema, prompt, the
# service and the ports) does no I/O of its own and is deterministic: no storage, no network, no
# files, no processes, no randomness and no wall clock. The model server is reached through the
# LlmJudge port and the verdicts through repository ports, both injected.
[importlinter:contract:llm-core-no-io]
name = The LLM escalation core must do no I/O of its own
type = forbidden
source_modules =
    social_tracker.llm.domain
    social_tracker.llm.schema
    social_tracker.llm.prompt
    social_tracker.llm.ports
    social_tracker.llm.service
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.bootstrap
    social_tracker.collector
    social_tracker.llm.ollama
    sqlite3
    socket
    ssl
    subprocess
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    urllib
    http
    os
    pathlib
    typer
    yaml
    random
    time

# The Ollama adapter is the only plain-http client of the application and it may talk to this
# machine only: which address is accepted is decided in `llm.domain.parse_loopback_url`
# (tests/llm pin it, and that the adapter source names no other host). It may use httpx2, the
# deadline layer it shares with the fetcher (`shared.iodeadline`, which is what touches httpcore2
# and ssl on its behalf) and the standard library; it never touches storage, other clients,
# sockets of its own, process, thread or event-loop machinery, dynamic imports or native code, or
# the collector. tests/architecture/test_llm_contracts.py also reads its imports and allows httpx2
# as the one network client.
[importlinter:contract:llm-adapter-loopback-only]
name = The Ollama adapter must stay a loopback-only HTTP client
type = forbidden
source_modules =
    social_tracker.llm.ollama
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.bootstrap
    social_tracker.collector
    social_tracker.control
    social_tracker.items
    social_tracker.sources
    social_tracker.catalog
    sqlite3
    socket
    ssl
    subprocess
    httpx
    httpcore
    httpcore2
    h11
    anyio
    urllib3
    requests
    aiohttp
    urllib
    http
    os
    pathlib
    typer
    yaml
    random
    importlib
    ctypes
    asyncio
    multiprocessing
ignore_imports =
    social_tracker.shared.iodeadline -> httpcore2
    social_tracker.shared.iodeadline -> ssl
unmatched_ignore_imports_alerting = none

# The alerts (AL-7, G-1): they are stored and shown on this machine and nothing else. The module
# (policy, excerpt, ports and the service) opens no connection, file, process or mail client, and
# knows neither the storage adapter nor the entrypoints nor the model server. The pure part, the
# vocabulary and the excerpt, is also deterministic: no clock, randomness, threads or logging (the
# service holds the clock and logs by injection and by name). The service reaches the classifier,
# the items, the sources, the model's judgments and the control settings through their ports.
[importlinter:contract:alerts-no-io]
name = The alerts module must do no I/O and send nothing out
type = forbidden
source_modules =
    social_tracker.alerts
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.bootstrap
    social_tracker.collector
    social_tracker.llm.ollama
    sqlite3
    socket
    ssl
    subprocess
    smtplib
    ftplib
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    websockets
    urllib
    http
    os
    pathlib
    io
    shutil
    tempfile
    glob
    typer
    yaml
    asyncio
    importlib
    ctypes
    multiprocessing

[importlinter:contract:alerts-core-pure]
name = The alert vocabulary and excerpt must be pure and deterministic
type = forbidden
source_modules =
    social_tracker.alerts.domain
    social_tracker.alerts.excerpt
    social_tracker.alerts.ports
forbidden_modules =
    social_tracker.control
    social_tracker.items
    social_tracker.sources
    social_tracker.llm
    social_tracker.alerts.service
    random
    time
    secrets
    uuid
    logging
    threading

# The gold set (G-1): labeled texts kept on this machine, measured against the cascade and
# exported only when the operator asks for a file. The module opens no connection, process or mail
# client, knows neither the storage adapter nor the entrypoints nor the model adapter (the judge is
# handed to the calibration as a function). `yaml` is allowed for the codec only (`yaml_io`); the
# vocabulary and the ports are also pure and deterministic.
[importlinter:contract:gold-no-io]
name = The gold set must do no I/O of its own and send nothing out
type = forbidden
source_modules =
    social_tracker.gold
forbidden_modules =
    social_tracker.persistence
    social_tracker.entrypoints
    social_tracker.bootstrap
    social_tracker.collector
    social_tracker.llm.ollama
    sqlite3
    socket
    ssl
    subprocess
    smtplib
    ftplib
    httpx
    httpx2
    httpcore2
    requests
    aiohttp
    websockets
    urllib
    http
    os
    pathlib
    io
    shutil
    tempfile
    glob
    typer
    asyncio
    importlib
    ctypes
    multiprocessing
# The service reads the topic vocabulary through the classification service, which (via its own
# codec) reaches modules this contract forbids to the gold set itself; only direct imports count.
allow_indirect_imports = True

[importlinter:contract:gold-core-pure]
name = The gold vocabulary and ports must be pure and deterministic
type = forbidden
source_modules =
    social_tracker.gold.domain
    social_tracker.gold.ports
forbidden_modules =
    social_tracker.control
    social_tracker.llm
    social_tracker.gold.service
    social_tracker.gold.yaml_io
    yaml
    random
    time
    secrets
    uuid
    logging
    threading
